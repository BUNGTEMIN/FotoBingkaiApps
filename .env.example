# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Appwrite Configs

# Server 1: LIKES & DATABASE (Using previous credential attributes)
VITE_APPWRITE_ENDPOINT="https://cloud.appwrite.io/v1"
VITE_APPWRITE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_APPWRITE_LIKE_ENDPOINT="https://cloud.appwrite.io/v1"
VITE_APPWRITE_LIKE_PROJECT_ID="YOUR_LIKE_PROJECT_ID"
VITE_APPWRITE_LIKE_DATABASE_ID="server_logs_db"
VITE_APPWRITE_LIKE_COLLECTION_ID="twlike"

# Server 2: NEW STORAGE & UPLOADS BUCKET (Using new credentials attributes)
VITE_APPWRITE_STORAGE_ENDPOINT="https://cloud.appwrite.io/v1"
VITE_APPWRITE_STORAGE_PROJECT_ID="YOUR_STORAGE_PROJECT_ID"
VITE_APPWRITE_STORAGE_BUCKET_ID="YOUR_STORAGE_BUCKET_ID"
VITE_APPWRITE_BUCKET_ID="YOUR_BUCKET_ID"
